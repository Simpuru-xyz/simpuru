{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Simpuru",
  "description": "Design prompts you and your agents can buy, one at a time, on Cardano. Live on preprod.",
  "colors": {
    "primary": "#6E5BD8",
    "light": "#B9A7F0",
    "dark": "#5A48C4"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://simpuru.xyz"
  },
  "favicon": "/favicon.svg",
