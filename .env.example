# Copy to .env (never commit .env). Preprod only.
CARDANO_NETWORK=preprod
BLOCKFROST_PROJECT_ID=
# 24-word mnemonics for test wallets. Use fresh wallets, never real funds.
SELLER_MNEMONIC=
BUYER_MNEMONIC=
ARBITER_MNEMONIC=
# Buyer agent: ceiling per payment, and the API it buys from
MAX_PER_PAYMENT_LOVELACE=20000000
DAILY_BUDGET_LOVELACE=50000000
# The live API by default; http://localhost:4021 when you run apps/api yourself
SIMPURU_API_URL=https://api.simpuru.xyz
PORT=4021
NEXT_PUBLIC_API_URL=http://localhost:4021
# Shared secret for the arbiter HTTP API (24+ chars)
ARBITER_TOKEN=
